{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../packages/*/src/**/*.ts"
  ]
  ,
  "exclude": [
    "../packages/*/src/**/*.test.ts",
    "../packages/*/src/**/__tests__/**",
    "node_modules"
  ]
}
